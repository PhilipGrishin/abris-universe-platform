{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "abris-universe",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-26",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
