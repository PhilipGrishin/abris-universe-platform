!collaboration/claude/inbox/.gitkeep
collaboration/claude/outbox/*
!collaboration/claude/outbox/.gitkeep
collaboration/claude/archive/*
!collaboration/claude/archive/.gitkeep
collaboration/codex/inbox/*
