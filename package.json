{
  "name": "abris-universe-platform",
  "version": "0.0.0",
  "private": true,
  "description": "Abris Universe platform workspace",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "test": "pnpm run verify:fixtures && pnpm run verify:workspace && pnpm --filter @abris-universe/domain-core test && pnpm --filter @abris-universe/oxs-importer test",
    "typecheck": "pnpm --filter @abris-universe/domain-core typecheck && pnpm --filter @abris-universe/oxs-importer typecheck",
    "verify:fixtures": "node tests/fixtures/oxs/verify-fixtures.mjs",
    "verify:workspace": "node scripts/verify-workspace.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
